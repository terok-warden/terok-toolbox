#
# Persistent warden release-officer container, managed by distrobox.
#
# Created once with `--unshare-all` so the host SSH agent, D-Bus
# session, and personal $HOME stay outside its view; subsequent
# invocations are fast `podman exec`s into the running container.
#
# Usage:
#   warden                       # interactive shell
#   warden <cmd> [args...]       # run a command directly
#     e.g. warden terok-release plan sandbox..terok
#          warden gh auth status
#   WARDEN_REBUILD=1 warden      # recreate the container

set -euo pipefail

CONTAINER=warden
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HOME_DIR="${WARDEN_HOME:-$HOME/warden/home}"
IMAGE="${WARDEN_IMAGE:-registry.fedoraproject.org/fedora-toolbox:44}"
PACKAGES="gh poetry python3-click python3-tomlkit python3-pydantic python3-rich"

if [ "${WARDEN_REBUILD:-0}" = "1" ]; then
    distrobox rm -f "$CONTAINER" 2>/dev/null || true
fi

if ! podman container exists "$CONTAINER"; then
    mkdir -p "$HOME_DIR"
    distrobox create \
        --name "$CONTAINER" \
        --image "$IMAGE" \
        --home "$HOME_DIR" \
        --unshare-all \
        --volume "$ROOT:/toolbox" \
        --additional-packages "$PACKAGES" \
        --init-hooks "ln -sf /toolbox/scripts/terok-release-chain.py /usr/local/bin/terok-release" \
        --yes
fi

# Strip the host's SSH agent socket before entering the container —
# distrobox (even with --unshare-all) bind-mounts /run/user/$UID, which
# carries the host's ssh-agent socket.  Without this, ``git push`` over
# SSH inside the container would silently use the host user's keys via
# that agent and attribute pushes to the host user instead of
# terok-warden.  The container instead uses its own ~/.ssh/id_ed25519
# (set up once via ``warden ssh-keygen`` — see README).
unset SSH_AUTH_SOCK

# Override the chain script's TEROK_GH_FORK inside the container so it
# pushes release-prep branches to the org directly (where warden has
# write access via the release-officers team) instead of inheriting
# the host operator's personal-fork preference.  Operator can point
# warden at a different fork by setting TEROK_WARDEN_GH_FORK on the
# host; the chain script's --fork remains mandatory for callers
# outside warden so a local run against a personal fork keeps working.
EXTRA_FLAGS="-e TEROK_GH_FORK=${TEROK_WARDEN_GH_FORK:-terok-ai}"

if [ $# -eq 0 ]; then
    exec distrobox enter --additional-flags "$EXTRA_FLAGS" "$CONTAINER"
else
    exec distrobox enter --additional-flags "$EXTRA_FLAGS" "$CONTAINER" -- "$@"
fi
